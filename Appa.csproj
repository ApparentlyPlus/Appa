<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);scratch\**;tests\**</DefaultItemExcludes>
    <Version>2.2.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>assets/appa.ico</ApplicationIcon>
    <Product>Appa</Product>
    <Company>ApparentlyPlus</Company>
    <AssemblyTitle>The Gata Compiler</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Benchmarks" />
    <InternalsVisibleTo Include="Appa.Tests" />
  </ItemGroup>

</Project>
